{
  "name": "@turbodocx/embed",
  "version": "0.2.1",
  "description": "TurboSign embedded-signing widget - a framework-agnostic web component and a React component that frame an embed URL, pin the origin, and surface the turbosign:completed event",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "turbodocx",
    "turbosign",
    "esignature",
    "digital-signature",
    "embedded-signing",
    "web-component",
    "custom-element",
    "react",
    "iframe",
    "postmessage"
  ],
  "author": "TurboDocx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TurboDocx/SDK.git",
    "directory": "packages/embed"
  },
  "homepage": "https://www.turbodocx.com",
  "bugs": {
    "url": "https://github.com/TurboDocx/SDK/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.3.0",
    "@vitest/coverage-istanbul": "3.2.7",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@2": "^2.1.4",
    "js-yaml": "^3.15.1"
  }
}
