{
  "name": "@turbodocx/sdk",
  "version": "0.9.0",
  "description": "TurboDocx JavaScript SDK - Digital signatures, document generation, and AI-powered workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "oxlint .",
    "lint:types": "oxlint --type-aware .",
    "lint:ci": "node scripts/oxlint-baseline.mjs --check",
    "lint:baseline": "node scripts/oxlint-baseline.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "turbodocx",
    "document",
    "generation",
    "api",
    "sdk",
    "signature",
    "turbosign",
    "esignature",
    "digital-signature",
    "document-automation"
  ],
  "author": "TurboDocx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TurboDocx/SDK.git",
    "directory": "packages/js-sdk"
  },
  "homepage": "https://www.turbodocx.com",
  "bugs": {
    "url": "https://github.com/TurboDocx/SDK/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "dotenv": "17.4.2",
    "jest": "^30.4.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "js-yaml": "^3.15.2"
  }
}
