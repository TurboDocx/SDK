{
  // Type-checks the tests as well as the sources (ts-jest used to do this during the test run;
  // Vitest strips types without checking them). Not used for the build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
