# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.
#
# Read by server.ts (the backend-for-frontend) via dotenv. The API key stays SERVER-SIDE and never
# reaches the browser — the React SPA only ever calls this server's /api/* routes.

# Required — a TurboDocx API key for an org with embedded signing enabled.
TURBODOCX_API_KEY=your-api-key-here

# Required — the TurboDocx org id.
TURBODOCX_ORG_ID=your-org-id-here

# Required — reply-to address, recorded as the sender in the audit trail.
TURBODOCX_SENDER_EMAIL=you@yourcompany.com

# Optional — sender display name shown to signers and in the audit trail.
TURBODOCX_SENDER_NAME=Embedded Signing Demo

# Optional — defaults to TurboDocx production. Set only for local testing against a dev backend
# (e.g. http://localhost:3000), and allow this app's origin in that backend's CORS.
# TURBODOCX_API_URL=http://localhost:3000

# Optional — port for server.ts (the /api backend). Default 4000. The Vite dev proxy targets this
# same value, so change both together via this one var.
# PORT=4000
