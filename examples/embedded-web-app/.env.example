# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.
#
# This folder has TWO ways to run, and they read different variable names from this same file:
#
#   1. The Vite + React SPA (npm run dev)  -> reads the VITE_* vars below (browser).
#   2. The server-side variant (server.ts) -> reads the plain vars at the bottom (Node).
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
# SPA (npm run dev) — VITE_* vars
# ─────────────────────────────────────────────────────────────────────────────────────────────
# ⚠ These are inlined into the client bundle AT BUILD TIME. Anyone who loads the page (or a built
#   static asset) can read them. This is fine for a local demo you run yourself, but DO NOT deploy
#   a build with a real key — in production use the server-side variant (server.ts) so the key stays
#   on your server. See the README.

# Required — a TurboDocx API key for an org with embedded signing enabled.
VITE_TURBODOCX_API_KEY=your-api-key-here

# Required — the TurboDocx org id.
VITE_TURBODOCX_ORG_ID=your-org-id-here

# Required — reply-to address, recorded as the sender in the audit trail.
VITE_TURBODOCX_SENDER_EMAIL=you@yourcompany.com

# Optional — sender display name.
VITE_TURBODOCX_SENDER_NAME=Northwind Mutual

# Optional — defaults to TurboDocx production. Set this ONLY for local testing against a dev backend
# (e.g. http://localhost:3000). If you do, allow this app's origin in that backend's CORS allow-list.
# VITE_TURBODOCX_API_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────────────────────
# Server-side variant (npx tsx server.ts) — plain vars, key never reaches the browser
# ─────────────────────────────────────────────────────────────────────────────────────────────
TURBODOCX_API_KEY=your-api-key-here
TURBODOCX_ORG_ID=your-org-id-here
TURBODOCX_SENDER_EMAIL=you@yourcompany.com
TURBODOCX_SENDER_NAME=Northwind Mutual
# TURBODOCX_API_URL=http://localhost:3000
