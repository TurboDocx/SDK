# Copy this file to `.env` and fill in the values, then run the demo (see README).
# The real `.env` is gitignored — never commit it.

# Your TurboDocx API key. Stays SERVER-SIDE — keep it secret, never expose it to the browser.
TURBODOCX_API_KEY=

# The organization ID the signing document is created under.
TURBODOCX_ORG_ID=

# The sender email shown on the document and used for the completion notification.
TURBODOCX_SENDER_EMAIL=

# The sender display name shown to the signer.
TURBODOCX_SENDER_NAME=Northwind Mutual

# Optional: point the SDK at a non-default backend (e.g. http://localhost:3000 for local dev).
# Leave blank to use the default TurboDocx API.
TURBODOCX_API_URL=

# Port this demo host app listens on (must match the allow-listed origin, default http://localhost:4000).
PORT=4000
