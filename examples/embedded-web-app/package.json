{
  "name": "turbodocx-embedded-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Embedded TurboSign signing in a Vite + React + shadcn app: three paths (single signer, sequential kiosk, drop-in widget) over a key-safe backend-for-frontend.",
