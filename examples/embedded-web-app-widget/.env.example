# TurboDocx credentials for the embedded-signing WIDGET demo. Copy to `.env` and fill in.
# The API key stays SERVER-SIDE; the browser never sees it.

# Required: your TurboDocx API key and organization id.
TURBODOCX_API_KEY=your-api-key-here
TURBODOCX_ORG_ID=your-org-id-here

# Required: the sender identity shown on the signature request emails.
TURBODOCX_SENDER_EMAIL=support@yourcompany.com
TURBODOCX_SENDER_NAME=Northwind Mutual

# Optional: point at a non-default API (e.g. a local backend during development).
# TURBODOCX_API_URL=http://localhost:3000

# Optional: port for this demo host app (default 4100). Allow-list this origin in the signer's org.
# PORT=4100
