# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.
# Loaded by `dotenv/config` from THIS directory, so run the server from here.

# Required — your TurboDocx API key (kept server-side; never sent to the browser).
TURBODOCX_API_KEY=your-api-key-here

# Required — the organization the document is created under.
TURBODOCX_ORG_ID=your-org-id-here

# Required — reply-to address, recorded as the sender in the audit trail.
TURBODOCX_SENDER_EMAIL=support@yourcompany.com

# Optional — display name for the sender.
TURBODOCX_SENDER_NAME=Kiosk Demo

# Optional — point at a non-default backend (e.g. a local dev API).
# TURBODOCX_API_URL=http://localhost:3000

# Optional — the port this demo listens on (default 4100). Allow-list the matching
# http://localhost:<PORT> origin in the org's embedded-signing allowed origins.
# PORT=4100
